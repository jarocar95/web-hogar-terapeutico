{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "deny",
    "webfetch": "deny",
    "external_directory": "deny",
    "read": {
      "*": "allow",
      "*.env*": "deny",
      "**/.env*": "deny",
      ".mcp.json": "deny",
      "**/.mcp.json": "deny",
      "**/client-secrets*": "deny"
    },
    "bash": { "*": "deny", "ls*": "allow", "git log*": "allow", "git show*": "allow" }
  }
}
