{
  "name": "web-hogar-terapeutico",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm-run-all build:icons build:css typecheck build:js build:11ty",
    "build:11ty": "eleventy",
    "build:css": "./node_modules/.bin/tailwindcss -i ./src/input.css -o ./public/dist/output.css --minify",
    "build:fonts": "python3 scripts/build-fonts.py",
    "build:icons": "node scripts/build-icons.mjs",
    "build:js": "node scripts/build-js.mjs",
    "playwright:install": "playwright install",
    "playwright:install:deps": "playwright install-deps",
    "start": "npm-run-all --parallel watch:*",
    "test": "jest",
    "test:all": "npm-run-all test test:e2e",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project=\"Mobile Chrome\"",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:hello": "echo 'Hello World'",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "watch:11ty": "eleventy --serve",
    "watch:css": "./node_modules/.bin/tailwindcss -i ./src/input.css -o ./public/dist/output.css --watch",
    "watch:js": "node scripts/build-js.mjs --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/typography": "^0.5.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "litepicker": "^2.0.12",
    "npm-run-all": "^4.1.5",
    "remixicon": "^4.9.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=20.9"
  }
}
